# Flask Configuration
FLASK_SECRET_KEY=your-secret-key-here-min-32-chars
SUPERADMIN_SECRET_KEY=your-superadmin-secret-key-here-min-32-chars

# Super Admin Portal Port (default: 8080)
SUPERADMIN_PORT=8080
SUPERADMIN_HOST=0.0.0.0

# Email Configuration
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-email-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_MESSAGING_SERVICE_SID=

# SMS Provider (alternative to Twilio)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_URL=
SMS_SENDER_ID=

# WhatsApp Business Cloud API Configuration
WHATSAPP_ACCESS_TOKEN=your-whatsapp-business-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id

# PostgreSQL configuration (required for production)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=school

# Production settings
FLASK_DEBUG=false
