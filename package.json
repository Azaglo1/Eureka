{
  "name": "school-management",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js primary application for the school management system.",
  "scripts": {
    "start": "npm --prefix node-app start",
    "dev": "npm --prefix node-app run dev",
    "install:node": "npm --prefix node-app install",
    "postinstall": "npm --prefix node-app install",
    "prisma:generate": "npm --prefix node-app run prisma:generate",
    "prisma:migrate": "npm --prefix node-app run prisma:migrate",
    "prisma:studio": "npm --prefix node-app run prisma:studio"
  },
  "engines": {
    "node": ">=20"
  }
}
