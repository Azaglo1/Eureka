generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id          Int       @id @default(autoincrement())
  name        String
  schoolCode  String    @unique @map("school_code")
  description String?
  active      Int       @default(1)
  users       User[]
  students    Student[]

  @@map("schools")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?
  role         String
  schoolId     Int?     @map("school_id")
  loginCode    String   @unique @map("login_code")
  passwordHash String   @map("password_hash")
  privileges   String?  @default("")
  active       Int      @default(1)
  school       School?  @relation(fields: [schoolId], references: [id])

  @@map("users")
}

model Student {
  id            Int      @id @default(autoincrement())
  name          String
  studentNumber String?  @unique @map("student_number")
  schoolId      Int      @map("school_id")
  grade         String?
  section       String?
  email         String?
  active        Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  school        School   @relation(fields: [schoolId], references: [id])

  @@map("students")
}
