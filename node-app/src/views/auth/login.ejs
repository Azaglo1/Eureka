<section class="auth-shell">
  <div class="card auth-card shadow-sm">
    <div class="card-body p-4 p-md-5">
      <div class="d-flex align-items-center gap-3 mb-4">
        <img src="/assets/favicon.png" alt="EUREKA Logo" width="48" height="48" onerror="this.style.display='none'">
        <div>
          <h1 class="h3 mb-0">EUREKA</h1>
          <p class="text-secondary mb-0">School Management System</p>
        </div>
      </div>

      <% if (flash) { %>
        <div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <form method="post" action="/">
        <h2 class="h5">Welcome Back</h2>
        <p class="text-secondary">Sign in to access your school portal</p>

        <div class="mb-3">
          <label class="form-label" for="school_code">School Institution</label>
          <select class="form-select" id="school_code" name="school_code" required>
            <option value="">Select your school</option>
            <% schools.forEach((school) => { %>
              <option value="<%= school.schoolCode %>"><%= school.name %></option>
            <% }) %>
          </select>
        </div>

        <div class="mb-4">
          <label class="form-label" for="login_code">Access Credentials</label>
          <input class="form-control" id="login_code" name="login_code" type="password" placeholder="Enter your access code" required autocomplete="current-password">
        </div>

        <button type="submit" class="btn btn-primary w-100">Sign In</button>
      </form>
    </div>
    <div class="card-footer text-center text-secondary small">
      &copy; 2026 EUREKA School Management System
    </div>
  </div>
</section>
